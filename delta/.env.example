# Copy to .env (never commit it) or set these in your host's environment settings.
NODE_ENV=production
PORT=3000
BASE_URL=https://members.delta.example
DATA_DIR=/var/lib/delta            # database + uploaded files — put on persistent, backed-up storage (UK/EU region)
ADMIN_EMAILS=founder@delta.example  # these emails become admins the first time they request a sign-in link
DEMO_MODE=0                         # must be 0 in production

# Stripe (leave blank for TEST mode). Create a webhook to {BASE_URL}/api/stripe/webhook
# listening for checkout.session.completed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (leave blank to log only). Any SMTP provider, e.g. smtp://user:pass@smtp.provider.com:587
SMTP_URL=
MAIL_FROM=DELTA <hello@delta.example>

# "Continue with Google" — Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorised redirect URI: {BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# "Continue with Microsoft" — Azure portal → Microsoft Entra ID → App registrations → New registration,
# "Accounts in any organizational directory and personal Microsoft accounts"; Web redirect URI
# {BASE_URL}/auth/microsoft/callback; then Certificates & secrets → New client secret.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common     # "consumers" = personal Outlook/Hotmail accounts only

# "Sign in with Apple" — Apple Developer account → Identifiers → Services ID (with Sign in with Apple),
# return URL {BASE_URL}/auth/apple/callback; then Keys → a Sign in with Apple key (.p8 file).
APPLE_CLIENT_ID=          # the Services ID, e.g. com.delta.web
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=        # contents of the .p8 file; newlines may be written as \n
