# Copy to .env (never commit it) or set these in your host's environment settings.
NODE_ENV=production
PORT=3000
BASE_URL=https://members.delta.example
DATA_DIR=/var/lib/delta            # database + uploaded files — put on persistent, backed-up storage (UK/EU region)
ADMIN_EMAILS=founder@delta.example  # these emails become admins the first time they request a sign-in link
DEMO_MODE=0                         # must be 0 in production

# Stripe (leave blank for TEST mode). Create a webhook to {BASE_URL}/api/stripe/webhook
# listening for checkout.session.completed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (leave blank to log only). Any SMTP provider, e.g. smtp://user:pass@smtp.provider.com:587
SMTP_URL=
MAIL_FROM=DELTA <hello@delta.example>
