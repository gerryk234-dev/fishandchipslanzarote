{
  "name": "tickets-direct-lanzarote",
  "private": true,
  "type": "module",
  "description": "SEO-first static web app for Tickets Direct Excursions Lanzarote, with a Claude-powered booking assistant.",
  "scripts": {
    "import": "node scripts/import-wp.mjs",
    "import:posts": "node scripts/import-posts.mjs",
    "import:legal": "node scripts/import-legal.mjs",
    "build": "node build.mjs",
    "preview": "node build.mjs && python3 -m http.server 8080 -d dist",
    "gbp": "node scripts/gbp-kit.mjs",
    "redirects": "node scripts/redirect-map.mjs",
    "lang-qa": "node scripts/lang-qa.mjs",
    "google": "node scripts/google-data.mjs",
    "eticket": "node scripts/make-eticket.mjs",
    "dev": "node build.mjs && node scripts/dev-server.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "sharp": "^0.35.5"
  }
}
