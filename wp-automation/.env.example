# Copy this file to `.env` and fill in your details.
# `.env` is gitignored — never commit real credentials.

# Your WordPress site root (no trailing slash needed)
WP_URL=https://excursionsticketsdirect.com

# Your WordPress username or account email
WP_USER=your-username

# An Application Password created in WordPress:
#   wp-admin -> Users -> Profile -> Application Passwords -> Add New
# Copy the generated password here (spaces are fine, they're ignored).
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
